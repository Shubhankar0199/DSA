class Solution {
  public:
    void segregate0and1(vector<int> &arr) {
        int i=0;
        int n=arr.size();
        int j=0;
        while(j<n){
            if(arr[j]==0 && arr[i]==1){
                swap(arr[j],arr[i]);
                i++;
            }
            else if(arr[i]==0){
                i++;
            }
            j++;
        }
    }
};
