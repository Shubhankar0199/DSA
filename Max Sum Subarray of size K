class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        int i;
        int n;
        int sum=0;
        int maxsum = 0;
        n=arr.size();
        for(i=0;i<k;i++){
            sum=sum+arr[i];
        }
        maxsum=sum;
        for(i=0;i<n-k;i++){
            sum=sum-arr[i];
            sum=sum+arr[i+k];
            maxsum=max(maxsum,sum);
        }
        return maxsum;
    }
};
