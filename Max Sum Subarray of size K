class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        int i;
        int n;
        int max_sum=0;
        n=arr.size();
        int sum =0;
        for(i=0;i<k;i++){
            sum=sum+arr[i];
        }
        max_sum=sum;
        int j=k;
        while(j<n){
            sum=sum-arr[j-k];
            sum=sum+arr[j];
            max_sum=max(max_sum,sum);
            j++;
    }
    return max_sum;
    }
};
